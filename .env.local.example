# Resend (https://resend.com) — used to email inquiry/contact form submissions
RESEND_API_KEY=
# Verified sending address in your Resend account (e.g. contact@luxanaride.com)
INQUIRY_FROM_EMAIL=
# Where inquiry/contact form submissions should be delivered
INQUIRY_TO_EMAIL=

# Optional. Without this, the Contact page map uses the free Google Maps
# iframe embed (no key needed). Set this to use the official Maps Embed API
# instead (requires a Google Cloud project with Maps Embed API + billing enabled).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
